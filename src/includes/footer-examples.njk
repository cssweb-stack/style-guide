<div class="container main-content">
<header class="page-header">
<h1>Footers</h1>
<p>Shared footers for every unit, listed alphabetically by abbreviation.</p>

</header>
</div>
{% for unit in footerUnits %}
<section aria-labelledby="footer-unit-{{ unit.key | escape }}">
<div class="container"><h2 class="sg-footer-heading" id="footer-unit-{{ unit.key | escape }}">{{ unit.site.shortName | escape }}: {{ unit.site.name | escape }}</h2></div>
{% set site = unit.site %}
{% set social = unit.social %}
{% set footerId = 'showcase-' + unit.key %}
{% include "layouts/branding/footer/footer.njk" %}
</section>
{% endfor %}
