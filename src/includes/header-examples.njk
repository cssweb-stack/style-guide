<div class="container main-content">
<header class="page-header">
<h1>Headers</h1>
<p>Shared headers for every unit, listed alphabetically by abbreviation.</p>
</header>
</div>
{% for unit in footerUnits | headerExamples %}
<section aria-label="{{ unit.site.name | escape }}">
{% set site = unit.site %}
{% set navigation = unit.navigation %}
{% set headerId = 'showcase-' + unit.key %}
<header class="sticky-header sg-header-example">
{% include "layouts/branding/header/uh-brand.njk" %}
{% include "layouts/branding/header/unit-name.njk" %}
{% include "layouts/branding/header/unit-nav.njk" %}
</header>
</section>
{% endfor %}