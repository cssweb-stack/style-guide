<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Shared typography specimen</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="{{ '/common.css' | url }}" rel="stylesheet">
<style>body {padding: 1.5rem;} .site-main {min-height: 0;}</style>
</head>
<body>
<main class="site-main">
<h1>Page heading</h1>
<p class="intro-highlight">Tagline beneath the heading.</p>
<p class="page-intro">A larger introductory paragraph.</p>
<h2>Section heading</h2>
<h3>Subsection heading</h3>
<h4>Fourth-level heading</h4>
<h5>Fifth-level heading</h5>
<h6>Sixth-level heading</h6>
<p>Body paragraph with <strong>emphasis</strong> and <a href="{{ '/' | url }}" target="_top">a link</a>.</p>
<p class="text-note">A small explanatory note.</p>
<p class="credits">Credits (3 credits)</p>
</main>
</body>
</html>
